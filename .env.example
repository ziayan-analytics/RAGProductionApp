# OpenAI
OPENAI_API_KEY=replace_me

# MySQL / warehouse
WAREHOUSE_DATABASE_URL=mysql+pymysql://user:password@host:3306/database_name
WAREHOUSE_SOURCE_ID=disc_medicine_articles
WAREHOUSE_SYNC_QUERY=SELECT id, title, therapeutic_area, program, indication_name, summary, body, source_url FROM disc_medicine_articles ORDER BY id
WAREHOUSE_PRIMARY_KEY_COLUMNS=id
WAREHOUSE_TEXT_COLUMNS=title,summary,body
WAREHOUSE_METADATA_COLUMNS=therapeutic_area,program,indication_name,source_url

# Qdrant local or cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docs

# Local Inngest dev server polling URL
INNGEST_API_BASE=http://127.0.0.1:8288/v1
